  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(claude_ai_Notion|notion)__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/notion-guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__(claude_ai_Exa|exa)__.*|mcp__(claude_ai_Firecrawl|firecrawl)__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/budget-guard.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/push-guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__(claude_ai_Notion|notion)__notion-(create-pages|create-database)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/notion-guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__(claude_ai_Exa|exa)__.*|mcp__(claude_ai_Firecrawl|firecrawl)__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/usage-counter.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/session-start.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
